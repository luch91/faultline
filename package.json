{
  "name": "minsk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "benchmark": "pnpm --filter @minsk/simulator benchmark",
    "benchmark:models": "tsx scripts/benchmark-models.ts",
    "verify:certificate": "tsx scripts/verify-certificate.ts",
    "demo:journey": "tsx scripts/demo-journey.ts",
    "e2e": "playwright test",
    "lint": "pnpm -r lint",
    "check:content": "node scripts/check-content.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "dev": "pnpm --parallel --filter @minsk/api --filter @minsk/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.38.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
